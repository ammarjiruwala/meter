# Copy to .env and fill in real values. Never commit .env — it's already in .gitignore.

# --- LLM providers (master company keys, used to forward real requests) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Datastores ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meter
REDIS_URL=redis://localhost:6379

# --- Prava (sandbox) — see docs/prava/authentication.md ---
# Secret key: server-side only, used for session/mandate/card API calls.
PRAVA_SECRET_KEY=sk_test_xxx
# Publishable key: safe for the dashboard frontend, used to init the Prava SDK.
NEXT_PUBLIC_PRAVA_PUBLISHABLE_KEY=pk_test_xxx
# Standing mandate the Treasurer Agent charges against — see docs/prava/concepts/mandates.md
PRAVA_MANDATE_ID=

# --- Poke / Linq (iMessage alerts) ---
POKE_API_KEY=
POKE_ALERT_PHONE_NUMBER=

# --- Treasurer Agent ---
# Rehearse top-up decisions without spending real sandbox funds. Do not flip without asking.
TREASURER_DRY_RUN=true
TREASURER_MAX_TOPUP_USD=200
TREASURER_MAX_DAILY_USD=500

# --- Circuit breaker ---
BREAKER_ENABLED=true
# open: serve traffic against cached ceiling if the ledger is unreachable
# closed: drop traffic rather than risk an unmetered call
FAIL_MODE=open

# --- Dashboard (Next.js) ---
NEXT_PUBLIC_METER_API_URL=http://localhost:8080
