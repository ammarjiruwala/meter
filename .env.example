# Meter — local configuration. Copy to `.env`; `.env` is gitignored and must stay that way.
#
# Variables are grouped by owner so you only have to fill in the ones your piece needs.
# Anything marked REQUIRED has no safe default and the proxy will refuse to start without it.

# ─────────────────────────────────────────────────────────────────────────────
# Provider keys (Shubh — proxy)
# ─────────────────────────────────────────────────────────────────────────────
# The "master company key" from CONTEXT.md §3. Callers never send these; they send
# a Meter key, and the proxy substitutes the provider key on the way out. That
# substitution is the entire reason a client can point an SDK at Meter without
# handing Meter's operator a key it did not already own.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Upstream base URLs. Override to point at a mock/record-replay server during a demo
# so a flaky conference network cannot break the pitch.
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Sent upstream on Anthropic requests when the caller does not supply its own.
ANTHROPIC_VERSION=2023-06-01

# Seconds to wait for the upstream provider. Streams routinely run minutes, so this
# is a *connect/read* timeout on individual socket operations, not a total budget.
UPSTREAM_TIMEOUT_S=600
UPSTREAM_CONNECT_TIMEOUT_S=10

# ─────────────────────────────────────────────────────────────────────────────
# Meter keys and projects (Shubh — proxy)
# ─────────────────────────────────────────────────────────────────────────────
# Comma-separated `meter_key:project_id:environment` triples, seeded into the DB at
# startup. Keys are stored as SHA-256 hashes, never in plaintext (ARCHITECTURE.md §4
# specifies `meter_keys.hash`). Re-seeding is idempotent.
#
# This is a Phase 1 shim. Once Shivam's project/key tables land, keys get provisioned
# through the DB and this variable goes away.
METER_KEYS=mk_dev_local:demo-project:dev

# ─────────────────────────────────────────────────────────────────────────────
# Ledger (Shubh — proxy; replaced by Shivam's Postgres in Phase 2)
# ─────────────────────────────────────────────────────────────────────────────
# Phase 1 ledger is a local SQLite file so the proxy runs standalone with no
# infrastructure. Column names deliberately match ARCHITECTURE.md §4 so the port to
# Postgres is a schema swap and not a rewrite of every call site.
METER_DB_PATH=meter.db

# Which `pricing/{version}.yaml` to price against. Stored per ledger row, so historical
# rows stay reproducible when rates change (ARCHITECTURE.md §3).
PRICING_VERSION=2026-08-01

# `open` (default) or `closed`. Fail-open serves the request when the ledger is
# unreachable; fail-closed drops the traffic instead. README.md "Fail mode".
FAIL_MODE=open

# ─────────────────────────────────────────────────────────────────────────────
# Circuit breaker (Shubh — proxy)
# ─────────────────────────────────────────────────────────────────────────────
BREAKER_ENABLED=true

# Detection is two conditions and BOTH must hold (ARCHITECTURE.md §6).
#
# 1. FLOOR — trailing BREAKER_WINDOW_S spend must clear BREAKER_WINDOW_USD. This is the
#    "$20 in 5 minutes" from CONTEXT.md §5C, and it is what makes detection fast.
BREAKER_WINDOW_S=300
BREAKER_WINDOW_USD=20.0

# 2. BURST — that window's spend *rate* must exceed the trailing baseline window's average
#    rate by this multiple. Without it, a feature that legitimately costs more than the
#    floor trips the breaker every five minutes forever.
#
#    The ratio is capped by the window sizes: 3600/300 = 12x maximum. A threshold above
#    the ceiling makes the breaker unfirable. Set BREAKER_BURST_RATIO=0 to disable the
#    burst check and fall back to the flat floor — the escape hatch if it misbehaves live.
BREAKER_BASELINE_WINDOW_S=3600
BREAKER_BURST_RATIO=3.0

# `throttle` returns 429 for the offending attribution tag only and lets all other
# traffic flow (the right answer to a retry storm). `revoke` cuts the Meter key
# entirely with a 403 (the right answer to a leaked credential).
BREAKER_MODE=throttle

# How long a tripped breaker stays shut before it half-opens and re-evaluates.
# Without this the demo trips the breaker and strands you on stage.
BREAKER_COOLDOWN_S=120

# ─────────────────────────────────────────────────────────────────────────────
# Treasurer / Prava (Shivam — not read by the proxy)
# ─────────────────────────────────────────────────────────────────────────────
# Prava sandbox key naming per docs/prava/authentication.md: secret key is server-side
# only (sk_test_*), used for session/mandate/card API calls.
PRAVA_API_KEY=sk_test_xxx
# Standing mandate the Treasurer Agent charges against — see docs/prava/concepts/mandates.md
PRAVA_MANDATE_ID=

# Rehearses the full top-up decision path and logs it without transacting.
# Defaults to true and stays true unless someone explicitly asks otherwise.
TREASURER_DRY_RUN=true
TREASURER_MAX_TOPUP_USD=200
TREASURER_MAX_DAILY_USD=500

# Burn-rate check interval. 30s is the documented default and what a real deployment
# should run — the Treasurer is heavily rate-limited by design and a tighter loop mostly
# spends someone's sandbox quota. Drop it to 3 on the DEMO BOX ONLY: a 30-second silence
# on stage while everyone waits for the top-up is a bad 30 seconds.
# ⚠ Confirm the Prava sandbox rate limit before running at 3 (PROPOSALS.md A3, C3).
TREASURER_INTERVAL_S=30

# ─────────────────────────────────────────────────────────────────────────────
# Alerts (Tanay — not read by the proxy)
# ─────────────────────────────────────────────────────────────────────────────
POKE_API_KEY=
POKE_CTO_PHONE=

# ─────────────────────────────────────────────────────────────────────────────
# Dashboard (Tanay — Next.js, not read by the proxy)
# ─────────────────────────────────────────────────────────────────────────────
# Publishable key: safe for the browser, used to init the Prava SDK client-side.
NEXT_PUBLIC_PRAVA_PUBLISHABLE_KEY=pk_test_xxx
NEXT_PUBLIC_METER_API_URL=http://localhost:8080

# ─────────────────────────────────────────────────────────────────────────────
# Phase 2 — Postgres/Redis (Shivam; not read by the Phase 1 proxy, which uses
# METER_DB_PATH/SQLite above until the ledger port lands)
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meter
REDIS_URL=redis://localhost:6379
